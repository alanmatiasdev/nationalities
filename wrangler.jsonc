{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nationalities",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-05",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "data.enyx.com.br",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
